# Gateway, runs on Unraid
PORT=3000
PLEX_URL=http://192.168.1.20:32400
PLEX_TOKEN=replace-with-plex-token
PLEX_MUSIC_LIBRARY=Music
GATEWAY_API_KEY=replace-with-a-long-random-value
STREAM_SIGNING_SECRET=replace-with-a-different-long-random-value
STREAM_URL_MAX_TTL_SECONDS=21600
MAX_QUEUE_TRACKS=150

# Public HTTPS URL routed to the gateway through your reverse proxy
GATEWAY_BASE_URL=https://music.example.com

# Alexa Lambda
QUEUE_TABLE=alexa-plex-proxy-queues
ALEXA_SKILL_ID=amzn1.ask.skill.replace-me
STREAM_URL_TTL_SECONDS=900
