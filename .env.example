ALEXA_SKILL_ID=amzn1.ask.skill.replace-me
ALEXA_SKILL_STAGE=development
ASK_PROFILE=default
PLEX_URL=https://your-public-plex-host.plex.direct:32400
PLEX_TOKEN=replace-with-your-plex-token
PLEX_MUSIC_LIBRARY=Music
STREAM_BASE_URL=https://replace-me.cloudfront.net
QUEUE_TABLE=alexa-plex-proxy-queues
MAX_QUEUE_TRACKS=150
MAX_AUDIO_BITRATE=192
TRANSCODE_POLICY=auto
QUEUE_TTL_HOURS=24
PLEX_REQUEST_TIMEOUT_MS=10000
LYRICS_MODE=plex-lrclib
LYRICS_REQUEST_TIMEOUT_MS=2500
PERSONALITY_MODE=spicy
RADIO_TRACK_LIMIT=50
ALLOW_PLAYLIST_WRITES=true
